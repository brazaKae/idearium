# Idearium API — variáveis de ambiente
# Copie para .env e preencha. Nunca commitar .env.

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
WEB_URL=http://localhost:4200
APP_VERSION=0.1.0

# Logging
LOG_LEVEL=debug

# Database (Postgres)
DATABASE_URL=postgresql://idearium:idearium_dev@localhost:5432/idearium?schema=public

# Auth — JWT
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-32-bytes-hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Sentry (opcional em dev — deixe vazio para desabilitar)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
