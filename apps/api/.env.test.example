# Idearium API — variáveis para testes (e2e)
# Copie para .env.test (gitignored). globalSetup do Jest carrega esse arquivo.

DATABASE_URL=postgresql://idearium:idearium_dev@localhost:5432/idearium_test?schema=public
JWT_ACCESS_SECRET=test-secret-not-for-production-use
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
LOG_LEVEL=fatal
